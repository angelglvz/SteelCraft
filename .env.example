# SteelCraft Backend Environment Variables
# Copy this file to .env and fill with your own values

# ============================================
# DATABASE CONFIGURATION
# ============================================
DATABASE_URL=postgresql://steelcraft_user:steelcraft_password@localhost:5432/steelcraft

# ============================================
# JWT & SECURITY
# ============================================
JWT_SECRET_KEY=your-super-secret-key-change-this-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================
# API CONFIGURATION
# ============================================
API_TITLE=SteelCraft API
API_VERSION=1.0.0
API_DESCRIPTION=Track and analyze your gym progress

# ============================================
# CORS CONFIGURATION
# ============================================
# For development
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080

# For production (uncomment and modify)
# ALLOWED_ORIGINS=https://your-frontend-domain.com

# ============================================
# ENVIRONMENT
# ============================================
ENVIRONMENT=development
DEBUG=True

# For production, set to:
# ENVIRONMENT=production
# DEBUG=False

# ============================================
# OPTIONAL: SMTP FOR EMAIL (future feature)
# ============================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SENDER_EMAIL=noreply@steelcraft.app

# ============================================
# OPTIONAL: REDIS FOR CACHING (future feature)
# ============================================
# REDIS_URL=redis://localhost:6379

# ============================================
# OPTIONAL: OPENAI API (AI recommendations)
# ============================================
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4-turbo
